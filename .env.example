# Copy to .env for local development. In production (GoDaddy cPanel) set these
# in the Node.js app's environment variables instead.

# Port the Node server listens on (GoDaddy / cPanel usually sets this for you)
PORT=3000

# --- Contact form email (https://resend.com) -----------------------------
# Leave RESEND_API_KEY empty to skip sending email.
RESEND_API_KEY=
ENQUIRY_FROM=Life Event Ceremonies website <enquiries@lifeeventceremonies.com.au>
ENQUIRY_TO=hello@lifeeventceremonies.com.au

# --- Enquiry storage (cPanel MySQL) ---------------------------------------
# Leave DB_HOST empty to skip saving enquiries to the database.
DB_HOST=
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=
